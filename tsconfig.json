{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@edu-agent/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@edu-agent/demo-fixtures": [
        "./packages/demo-fixtures/src/index.ts"
      ],
      "@edu-agent/test-fixtures": [
