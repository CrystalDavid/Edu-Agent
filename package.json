{
  "name": "edu-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @edu-agent/contracts build && pnpm --filter @edu-agent/test-fixtures build && tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:e2e": "vitest run tests/e2e",
    "test:migrations": "vitest run tests/integration/migrations.test.ts",
    "test:static": "node scripts/gate1a-static-check.mjs",
    "test:node-smoke": "node --experimental-transform-types --import ./tests/support/register-gate1a-hooks.mjs --test ./tests/node/walking-skeleton.node.test.mjs",
    "db:env": "node scripts/postgres/create-local-env.mjs",
    "db:up": "docker compose --env-file infra/docker/.env.local -f infra/docker/compose.postgres.yml up -d --wait",
    "db:down": "docker compose --env-file infra/docker/.env.local -f infra/docker/compose.postgres.yml down --remove-orphans",
    "db:clean": "docker compose --env-file infra/docker/.env.local -f infra/docker/compose.postgres.yml down --volumes --remove-orphans",
    "db:migrate": "node scripts/postgres/run-with-local-env.mjs pnpm exec tsx apps/api/src/platform/postgres/bootstrap-cli.ts",
    "test:postgres": "node scripts/postgres/run-integration-tests.mjs",
    "dev": "pnpm --parallel --filter @edu-agent/api --filter @edu-agent/web dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
